<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.appdatabackup"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.APP_DATA_BACKUP" />
    <uses-permission android:name="android.permission.APP_DATA_RESTORE" />
    <!-- Needed to install APKs during restore -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <!-- Needed to force-stop apps before restoring data -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!-- Needed to read /data/data/* and /data/user_de/* -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Required to query all installed packages -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.AppDataBackup"
        android:supportsRtl="true">

        <!--
          Main entry point launched from Settings > System > Backup & Restore.
          Can also be launched standalone via:
            adb shell am start -n com.android.appdatabackup/.AppDataBackupActivity
        -->
        <activity
            android:name=".AppDataBackupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Deep link from Settings -->
            <intent-filter>
                <action android:name="android.settings.APP_DATA_BACKUP_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
