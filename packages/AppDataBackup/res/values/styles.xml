<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Extra-large, soft corners are the heart of the expressive look. -->
    <style name="ShapeAppearance.AppDataBackup.XLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.AppDataBackup.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Tonal, borderless cards that float on the background. -->
    <style name="Widget.AppDataBackup.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AppDataBackup.Card</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">0dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- Big, confident, pill-shaped action button. -->
    <style name="Widget.AppDataBackup.Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.AppDataBackup.Fab</item>
    </style>

    <style name="TextAppearance.AppDataBackup.Fab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Tabs rendered as a rounded, segmented pill. -->
    <style name="Widget.AppDataBackup.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.AppDataBackup.Tab</item>
        <item name="tabInlineLabel">true</item>
    </style>

    <style name="TextAppearance.AppDataBackup.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Headline used in the collapsing header. -->
    <style name="TextAppearance.AppDataBackup.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Widget.AppDataBackup.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
    </style>

    <!-- App-initial avatar tile. -->
    <style name="TextAppearance.AppDataBackup.Avatar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Rounded mask applied to real app-icon avatars. -->
    <style name="ShapeAppearanceOverlay.AppDataBackup.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Small metadata pill (version / date / size). -->
    <style name="Widget.AppDataBackup.MetaPill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
    </style>

    <style name="Widget.AppDataBackup.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.AppDataBackup.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="ThemeOverlay.AppDataBackup.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AppDataBackup.Dialog</item>
    </style>

    <style name="ShapeAppearance.AppDataBackup.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
