<?xml version="1.0" encoding="utf-8"?>
<!-- Selection-independent ripple so press feedback is identical whether the
     card is unselected (colorSurfaceVariant) or selected (colorPrimaryContainer). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="?attr/colorPrimary" android:alpha="0.12" />
    <item android:state_focused="true" android:color="?attr/colorPrimary" android:alpha="0.12" />
    <item android:state_hovered="true" android:color="?attr/colorPrimary" android:alpha="0.06" />
    <item android:color="@android:color/transparent" />
</selector>
